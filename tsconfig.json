{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],
		"strict": true,
		"jsx": "react-jsx",
		"skipLibCheck": true,
		"isolatedModules": true,
		"moduleResolution": "bundler",
		"noEmit": true
	},
	"include": ["src", "vite.config.ts"]
}
